{
  "name": "hexagonal-service",
  "version": "1.0.0",
  "description": "A TypeScript service template built on hexagonal architecture",
  "keywords": [
    "hexagonal",
    "service"
  ],
  "license": "MIT",
  "author": "Oliver Tuck",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "node --watch src/main.ts | pino-pretty",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "pino-pretty": "^13.2.0",
    "prettier": "3.9.9",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
